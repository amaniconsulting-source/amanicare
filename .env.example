# Copy to .env and fill in. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL connection (required). Migrations in migrations/ run automatically at startup.
# Neon: paste the pooled connection string as is (host with -pooler, ?sslmode=require&channel_binding=require).
DATABASE_URL=postgres://amanicare:amanicare@localhost:5432/amanicare
# Set to 1 when the database requires TLS (most managed Postgres services).
DATABASE_SSL=0
# Optional: tests use their own throwaway schema in this database (defaults to DATABASE_URL).
# Neon: use the direct string (no -pooler), ideally for a separate branch, not production.
TEST_DATABASE_URL=

# Sentry error monitoring for the server and the browser. Leave empty to turn it off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional: release name (defaults to amanicare@<package version>) and performance tracing (0 to 1).
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Set to 0 to keep Sentry on the server only.
SENTRY_BROWSER=1

# First admin: whoever logs in with this number becomes the admin.
ADMIN_PHONE=+12145550100

# Shows login codes on screen. MUST be 0 in production.
OTP_DEV=1

# Bill photos are stored in the database. UPLOAD_DIR is only read for photos saved on disk by older versions.
UPLOAD_DIR=data/uploads
# Optional: password-protect the whole site while testing online (privacy page and webhooks stay public).
SITE_PASSWORD=

# AI bill reading (Claude). Leave empty to disable; families then type the details.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Payments: sandbox | equity
PAYMENT_PARTNER=sandbox
PAYMENT_WEBHOOK_SECRET=change-me
EQUITY_API_BASE=
EQUITY_CLIENT_ID=
EQUITY_CLIENT_SECRET=

# Messaging: sandbox (outbox only) | whatsapp
MESSAGING=sandbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Templates are required by WhatsApp for messages AmaniCare starts (see docs/whatsapp-setup.md).
WHATSAPP_USE_TEMPLATES=1
WHATSAPP_TEMPLATE_PREFIX=
# Login codes need an authentication template (only after Meta business verification). Until then: 0.
WHATSAPP_LOGIN_CODES=0
