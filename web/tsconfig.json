{
  // Browser app (PWA). Compiled to plain ES modules in dist/public, served as /app.js etc.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": ".",
    "outDir": "../dist/public"
  },
  "include": ["*.ts"]
}
