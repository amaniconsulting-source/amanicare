{
  // Server and tests (Node). Browser code has its own configs in web/ and web/sw/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["server/**/*.ts", "test/**/*.ts"]
}
